# ── Covariates for smoothness test ────────────────────────────────────────────
covariates <- c(
"allied", "latitude", "longitude", "dist_line",
"turnout_state", "sh_prot", "sh_kath", "sh_angs",
"sh_worker", "sh_self", "sh_men", "sh_agri",
"sh_indu", "sh_trade", "sh_services",
"signal", "max_max_signal_strength_fix"
)
thresholds <- seq(100, 7000, by = 100)
# ── Storage ───────────────────────────────────────────────────────────────────
# One row per threshold × covariate combination
results_smooth <- data.frame(
threshold  = numeric(0),
covariate  = character(0),
coef_conv  = numeric(0),
coef_rb    = numeric(0),
se_rb      = numeric(0),
ci_lo      = numeric(0),
ci_hi      = numeric(0),
pv_rb      = numeric(0),  # pv[3,] — robust p-value
n_obs      = numeric(0),
stringsAsFactors = FALSE
)
# ── Loop ──────────────────────────────────────────────────────────────────────
for (X in thresholds) {
sub <- subset(total_1946, einwoh > X)
if (nrow(sub) < 20) { message(paste("Skip X =", X)); next }
for (cov in covariates) {
y_cov <- sub[[cov]]
if (sum(!is.na(y_cov)) < 20) next  # skip if too many NAs
rdd <- tryCatch(
rdrobust(
y        = y_cov,
x        = sub$SED_state,
c        = 50,
covs     = NULL,
p        = 1,
bwselect = "cerrd",
vce      = "HC0",
cluster  = sub$kreis
),
error = function(e) NULL
)
if (is.null(rdd)) next
coef_rb <- rdd$coef[3, ]
se_rb   <- rdd$se[3, ]
results_smooth <- rbind(results_smooth, data.frame(
threshold  = X,
covariate  = cov,
coef_conv  = rdd$coef[1, ],
coef_rb    = coef_rb,
se_rb      = se_rb,
ci_lo      = coef_rb - 1.96 * se_rb,
ci_hi      = coef_rb + 1.96 * se_rb,
pv_rb      = rdd$pv[3, ],
n_obs      = nrow(sub),
stringsAsFactors = FALSE
))
}
}
# ── Summary: how many p-values fall below 0.1 and 0.05 ───────────────────────
summary_pv <- aggregate(
pv_rb ~ covariate,
data = results_smooth,
FUN  = function(x) c(
n_tests   = length(x),
n_p10     = sum(x < 0.10, na.rm = TRUE),
n_p05     = sum(x < 0.05, na.rm = TRUE),
share_p10 = mean(x < 0.10, na.rm = TRUE),
share_p05 = mean(x < 0.05, na.rm = TRUE)
)
)
summary_pv <- do.call(data.frame, summary_pv)
names(summary_pv) <- c("covariate","n_tests","n_p10","n_p05","share_p10","share_p05")
print(summary_pv[order(summary_pv$share_p05, decreasing = TRUE), ])
# ── Plot 1: p-value heatmap across thresholds × covariates ───────────────────
library(ggplot2)
ggplot(results_smooth, aes(x = threshold, y = covariate, fill = pv_rb)) +
geom_tile() +
geom_hline(yintercept = seq(0.5, length(covariates) + 0.5), colour = "white", linewidth = 0.3) +
scale_fill_gradientn(
colours = c("#D85A30", "#EF9F27", "#E6F1FB", "#E6F1FB"),
values  = c(0, 0.05, 0.10, 1),
limits  = c(0, 1),
name    = "p-value\n(robust)"
) +
labs(
title    = "Smoothness test: robust p-values by covariate and threshold",
subtitle = "Red = p < 0.05  |  Orange = 0.05–0.10  |  Blue = p ≥ 0.10",
x        = "einwoh threshold", y = NULL
) +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank())
# ── Plot 2: share of thresholds with p < 0.05 per covariate ──────────────────
ggplot(summary_pv, aes(x = reorder(covariate, share_p05), y = share_p05)) +
geom_col(fill = "#378ADD", width = 0.7) +
geom_hline(yintercept = 0.05, linetype = "dashed", colour = "#D85A30") +
annotate("text", x = 1, y = 0.06, label = "5% false positive rate",
hjust = 0, size = 3, colour = "#D85A30") +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
coord_flip() +
labs(
title    = "Share of thresholds with robust p < 0.05 per covariate",
subtitle = "Red dashed = 5% expected by chance under the null",
x        = NULL, y        = "Share of thresholds"
) +
theme_minimal(base_size = 11)
# ── Plot 3: coefficient paths for each covariate (faceted) ───────────────────
ggplot(results_smooth, aes(x = threshold)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey60") +
geom_ribbon(aes(ymin = ci_lo, ymax = ci_hi), fill = "#378ADD", alpha = 0.15) +
geom_line(aes(y = coef_conv), colour = "#378ADD", linewidth = 0.7) +
facet_wrap(~ covariate, scales = "free_y", ncol = 3) +
labs(
title    = "Smoothness test: RD coefficient on pre-treatment covariates",
subtitle = "Line = conventional coef; ribbon = 95% CI centred on robust coef",
x        = "einwoh threshold", y = "RD coefficient"
) +
theme_minimal(base_size = 10) +
theme(strip.text = element_text(size = 8))
