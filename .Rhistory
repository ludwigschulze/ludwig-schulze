cat("Loading shapefile...\n")
Mmap <- read_sf("/Users/ludwig/Desktop/EUI/1st Paper/Maps/vg-hist.utm32s.shape/daten/utm32s/shape/VG-Hist_1990-12-31_GEM.shp")
Mmap <- st_make_valid(Mmap)
Mmap$centroid <- st_centroid(Mmap)
# Keep only East Germany (Land codes > 10)
Mmap <- Mmap %>%
mutate(Land = substr(AGS, 1, 2)) %>%
filter(Land > 10)
# ── Harmonize AGS: replace 3rd digit with "0" ────────────────────────────────
Mmap$AGS <- as.character(Mmap$AGS)
Mmap$AGS <- paste0(substr(Mmap$AGS, 1, 2), "0", substr(Mmap$AGS, 4, nchar(Mmap$AGS)))
# ── Verify match with census ──────────────────────────────────────────────────
n_match <- length(intersect(unique(Mmap$AGS), unique(combined_housing$ags_90)))
cat("Matched municipalities:", n_match, "\n")
cat("Unmatched census codes:", length(setdiff(unique(combined_housing$ags_90), unique(Mmap$AGS))), "\n")
# ── Join map with census ──────────────────────────────────────────────────────
cat("Joining map with census...\n")
map_GDR <- left_join(Mmap, combined_housing, by = c("AGS" = "ags_90"))
map_GDR$GEN
wismus <- read_excel("/Users/ludwig/Desktop/wismus.xlsx")
str(wismus)
# Parse coordinates from wismus (lat, lon format)
wismus_coords <- wismus %>%
tidyr::separate(coordinates, into = c("lat", "lon"), sep = ",\\s*", convert = TRUE) %>%
st_as_sf(coords = c("lon", "lat"), crs = 4326)
# Parse coordinates from wismus (lat, lon format)
wismus_coords <- wismus %>%
tidyr::separate(coordinates, into = c("lat", "lon"), sep = ",\\s*", convert = TRUE) %>%
filter(!is.na(lat), !is.na(lon)) %>%
st_as_sf(coords = c("lon", "lat"), crs = 4326)
# Make sure map_GDR centroids are sf objects in the same CRS
centroids <- map_GDR %>%
st_centroid() %>%
st_transform(crs = 4326)
# Find nearest wismus location for each centroid
nearest_idx <- st_nearest_feature(centroids, wismus_coords)
# Assign closest wismus info back to map_GDR
map_GDR <- map_GDR %>%
mutate(
nearest_wismus_place = wismus$place[nearest_idx],
nearest_wismus_type  = wismus$type[nearest_idx]
)
unique(map_GDR$nearest_wismus_place)
