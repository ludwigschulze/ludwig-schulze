combined_housing$V15[combined_housing$V15 == 9] <- NA
combined_housing$period <- as.numeric(combined_housing$V15)
# Housing quality outcome
combined_housing$V17[combined_housing$V17 == 5] <- NA
combined_housing <- subset(combined_housing, period > 1)
combined_housing$housing_quality <- dplyr::recode(combined_housing$V17, "1" = 4, "2" = 3, "3" = 2, "4" = 1)
# Admin
combined_housing$Old_County <- substr(combined_housing$gdr_tgs, 1, 5)
combined_housing$New_County <- substr(combined_housing$New_Gemeinden, 1, 5)
# Other outcomes #
# Building level
combined_housing$sewage <- combined_housing$V23
combined_housing$water_public <- combined_housing$V20
combined_housing$residen_building <- combined_housing$V12
combined_housing$building_type <- combined_housing$V14
combined_housing$multi_famihome <-  ifelse(combined_housing$V13 == 2,1,0)
combined_housing$floors <-  combined_housing$V16
combined_housing$distance_heating <-  combined_housing$V18
combined_housing$number_apartments <-  combined_housing$V26
# Apartment level
combined_housing$size <- combined_housing$V31
combined_housing$kitchen <- ifelse(combined_housing$V59 == 1, 1, 0)
combined_housing$hotwater = ifelse(combined_housing$V43 == 2,1,0)
combined_housing$number_apartment_inside <-  combined_housing$V27
combined_housing$number_households <- combined_housing$V44
combined_housing$ofenheizung_stromgasoel = ifelse(combined_housing$V38 == 4,1,0)
combined_housing$ofenheizung_kohleholz = ifelse(combined_housing$V38 == 3,1,0)
combined_housing$central_heating = ifelse(combined_housing$V38 == 2,1,0)
combined_housing$toilett = ifelse(combined_housing$V40 == 1,1,0)
combined_housing$waterconnec_inside = ifelse(combined_housing$V39 == 1,1,0)
combined_housing$shower = ifelse(combined_housing$V41 == 2,1,0)
combined_housing$gas_connect = ifelse(combined_housing$V42 == 2,1,0)
# index
