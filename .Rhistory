coef_rb    = coef_rb,
se_rb      = se_rb,
ci_lo      = coef_rb - 1.96 * se_rb,
ci_hi      = coef_rb + 1.96 * se_rb,
n_obs      = nrow(total_1946_sub)
))
}
# ── Plot ───────────────────────────────────────────────────────────────────────
library(ggplot2)
ggplot(results, aes(x = threshold, y = coef_conv)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50") +
geom_ribbon(aes(ymin = ci_lo, ymax = ci_hi),
fill = "#378ADD", alpha = 0.2) +
geom_line(colour = "#378ADD", linewidth = 0.9) +
geom_point(colour = "#378ADD", size = 1.5) +
